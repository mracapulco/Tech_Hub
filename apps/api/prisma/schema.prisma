  @@index([campaignId])
  @@index([entityType])
  @@index([action])
}

model MicrosoftDistributorConnection {
  id              String                    @id @default(uuid())
  provider        MicrosoftProvider         @unique
  environment     String                    @default("production")
  apiBaseUrl      String?
  subscriptionKeyEnc String?
  apiUser         String?
  apiPassEnc      String?
  marketplace     String?
  clientId        String?
  clientSecretEnc String?
  customerNumber  String?
  countryCode     String?
  senderId        String?
  apiKeyEnc       String?
  status          MicrosoftConnectionStatus @default(NOT_CONFIGURED)
  lastTestAt      DateTime?
  lastSyncAt      DateTime?
  lastError       String?
  autoSyncEnabled       Boolean             @default(false)
  autoSyncIntervalHours Int?
  nextSyncAt            DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  syncRuns        MicrosoftSyncRun[]

  @@index([status])
  @@index([autoSyncEnabled, nextSyncAt])
}

model MicrosoftDistributorCustomerMap {
  id                   String                     @id @default(uuid())
  provider             MicrosoftProvider
