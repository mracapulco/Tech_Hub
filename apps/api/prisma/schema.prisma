  externalCustomerName String
  externalStatus       String?
  externalTaxId        String?
  externalTenantId     String?
  externalTenantDomain String?
  company              Company?                   @relation(fields: [companyId], references: [id])
  companyId            String?
  matchStatus          MicrosoftCustomerMapStatus @default(SUGGESTED)
  confidence           Float?
  notes                String?
  firstSeenAt          DateTime                   @default(now())
  lastSeenAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([provider, externalCustomerId])
  @@index([companyId])
  @@index([matchStatus])
  @@index([externalTaxId])
}

model MicrosoftAgreement {
  id                String                   @id @default(uuid())
  company           Company?                 @relation(fields: [companyId], references: [id])
  companyId         String?
  site              Site?                    @relation(fields: [siteId], references: [id])
  siteId            String?
  sourceProvider    MicrosoftProvider?
  externalCustomerId String?
  externalCustomerName String?
  externalSubscriptionId String?
  vendorSubscriptionId String?
  productId         String?
  mpn               String?
  microsoftCustomerId String?
  microsoftTenantId String?
  microsoftDomain   String?
  providerStatus    String?
  renewalStatus     Boolean?
  isRecurring       Boolean                  @default(false)
  isReadOnly        Boolean                  @default(false)
  category          String
  productName       String
  sku               String?
  licenseType       String?
  licenseChannel    String?
  billingModel      String?
  subscriptionPeriod String?
  tenantName        String?
  tenantDomain      String?
  quantityPurchased Float?
  quantityActive    Float?
  unitPrice         Decimal?                 @db.Decimal(18, 2)
  unitCost          Decimal?                 @db.Decimal(18, 2)
  totalPrice        Decimal?                 @db.Decimal(18, 2)
  totalCost         Decimal?                 @db.Decimal(18, 2)
  currency          String?
  purchaseDate      DateTime?
  startDate         DateTime?
  renewalDate       DateTime?
  expiresAt         DateTime?
  autoRenew         Boolean                  @default(false)
  alertLeadDays     Int                      @default(30)
  status            MicrosoftAgreementStatus @default(PENDING_REVIEW)
  notes             String?
  createdById       String?
  updatedById       String?
  lastSeenAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  sources           MicrosoftAgreementSource[]
  documents         MicrosoftAgreementDocument[]

  @@index([companyId])
  @@index([siteId])
  @@index([sourceProvider])
  @@index([externalCustomerId])
  @@index([externalSubscriptionId])
  @@index([providerStatus])
  @@index([isRecurring])
  @@index([status])
  @@index([renewalDate])
  @@index([expiresAt])
  @@index([tenantDomain])
  @@unique([sourceProvider, externalSubscriptionId])
}

model MicrosoftAgreementSource {
  id                   String              @id @default(uuid())
  agreement            MicrosoftAgreement  @relation(fields: [agreementId], references: [id])
  agreementId          String
  provider             MicrosoftProvider
  sourceType           MicrosoftSourceType
  externalCustomerId   String?
  externalCustomerName String?
  externalRecordId     String?
  externalReference    String?
  payloadSummary       Json?
  observedAt           DateTime            @default(now())
  confidence           Float?
  fieldCoverage        Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([agreementId])
  @@index([provider])
  @@index([sourceType])
  @@index([externalCustomerId])
}

model MicrosoftAgreementDocument {
  id             String                @id @default(uuid())
  agreement      MicrosoftAgreement    @relation(fields: [agreementId], references: [id])
  agreementId    String
  company        Company               @relation(fields: [companyId], references: [id])
  companyId      String
  provider       MicrosoftProvider?
  documentType   MicrosoftDocumentType
  title          String
  documentNumber String?
  fileUrl        String?
  issuedAt       DateTime?
  amount         Decimal?              @db.Decimal(18, 2)
  currency       String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([agreementId])
  @@index([companyId])
  @@index([provider])
  @@index([documentType])
}

model MicrosoftSyncRun {
  id             String                        @id @default(uuid())
  provider       MicrosoftProvider
  connection     MicrosoftDistributorConnection? @relation(fields: [connectionId], references: [id])
  connectionId   String?
  status         MicrosoftSyncStatus
  startedAt      DateTime                      @default(now())
  finishedAt     DateTime?
  customersProcessed Int                        @default(0)
  subscriptionsFound Int                        @default(0)
  activeSubscriptions Int                       @default(0)
  recordsRead    Int                           @default(0)
  recordsCreated Int                           @default(0)
  recordsUpdated Int                           @default(0)
  recordsIgnored Int                           @default(0)
  markedNotFound Int                           @default(0)
  errorCount     Int                           @default(0)
  durationMs     Int?
  errorSummary   String?
  createdAt      DateTime                      @default(now())

  @@index([provider])
  @@index([connectionId])
  @@index([status])
  @@index([startedAt])
}
