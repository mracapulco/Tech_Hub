model InventoryAssetSnapshot {
  id                     String                      @id @default(uuid())
  company                Company                     @relation(fields: [companyId], references: [id])
  companyId              String
  campaign               InventoryCampaign           @relation(fields: [campaignId], references: [id])
  campaignId             String
  assetIdentity          InventoryAssetIdentity      @relation(fields: [assetIdentityId], references: [id])
  assetIdentityId        String
  site                   Site?                       @relation(fields: [siteId], references: [id])
  siteId                 String?
  assignedUser           InventoryAssetUser?         @relation(fields: [assignedUserId], references: [id])
  assignedUserId         String?
  sourceType             InventorySourceType?
  verificationStatus     InventoryVerificationStatus @default(UNVERIFIED)
  displayName            String
  hostname               String?
  serialNumber           String?
  assetTag               String?
  manufacturer           String?
  model                  String?
  operatingSystem        String?
  operatingSystemVersion String?
  sourceExternalId       String?
  collectedAt            DateTime?
  notes                  String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

