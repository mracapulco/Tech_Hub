  softwareInstallations  InventorySoftwareInstallation[]
  licenseAllocations     InventoryLicenseAllocation[]
  issueLinks             InventoryIssue[]
  reconciliationResults  InventoryReconciliationResult[]

  @@unique([campaignId, assetIdentityId])
  @@index([companyId])
  @@index([campaignId])
  @@index([siteId])
  @@index([assignedUserId])
}

model InventoryHardwareSnapshot {
  id                String                 @id @default(uuid())
