generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
  CLIENT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String?  @unique
  name      String
  lastName  String?
  password  String
  avatarUrl String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships UserCompanyMembership[]
  inventoryCampaignParticipants InventoryCampaignParticipant[]
}

model Company {
  id        String   @id @default(uuid())
  cnpj      String?  @unique
  name      String
  fantasyName String?
  address   String?
  city      String?
  state     String?
  zipcode   String?
  phone     String?
  logoUrl   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships UserCompanyMembership[]
  maturityAssessments MaturityAssessment[]
  sites      Site[]
  vrfs       Vrf[]
  subnets    IpSubnet[]
  firewallLicenses FirewallLicense[]
  backupRepositories BackupRepository[]
  backupProxies BackupProxy[]
  backupCores BackupCore[]
  backupJobs BackupJob[]
  backupRepositoryOverrides BackupRepositoryOverride[]
  backupRepositoryJobOverrides BackupRepositoryJobOverride[]
  backupVeeamSnapshots BackupVeeamSnapshotRaw[]
  backupSummaries BackupSummaryMonthly[]
  adFsProjects AdFsProject[]
  inventoryCampaigns InventoryCampaign[]
  inventoryAssetIdentities InventoryAssetIdentity[]
  inventoryAssetUsers InventoryAssetUser[]
  inventoryAssetSnapshots InventoryAssetSnapshot[]
  inventoryImportBatches InventoryImportBatch[]
  inventorySuppliers InventorySupplier[]
  inventoryDocuments InventoryEvidenceDocument[]
  inventoryLicenseEntitlements InventoryLicenseEntitlement[]
  inventoryIssues InventoryIssue[]
  inventoryReconciliationResults InventoryReconciliationResult[]
  inventoryAiSuggestions InventoryAiSuggestion[]
  inventoryAuditEvents InventoryAuditEvent[]
  microsoftAgreements MicrosoftAgreement[]
  microsoftAgreementDocuments MicrosoftAgreementDocument[]
  microsoftCustomerMaps MicrosoftDistributorCustomerMap[]
}

model UserCompanyMembership {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

// Log de auditoria: registro append-only de ações de usuários (autenticação, mutações
// de negócio e leituras sensíveis). Campos de ator/empresa são denormalizados de propósito
// (snapshot no momento do evento) para que o histórico sobreviva à edição/exclusão do
// usuário ou empresa relacionados — por isso não há relations/FKs aqui.
model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  actorUserId   String?
  actorUsername String?
  actorName     String?
  actorRole     String?

  companyId   String?
  companyName String?

  action      String
  entityType  String?
  entityId    String?
  description String

  changes Json?

  httpMethod String?
  route      String?
  ipAddress  String?
  userAgent  String?

  status       String  @default("SUCCESS")
  errorMessage String?
  severity     String  @default("INFO")

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

// Registro de testes de maturidade de segurança
model MaturityAssessment {
  id         String   @id @default(uuid())
  date       String
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String
  answers    Json?
  groupScores Json?
  totalScore Int?
  maxScore   Int?
  createdAt  DateTime @default(now())

  // Relação 1:1 com análise por IA (quando existir)
  analysis   MaturityAnalysis?
}

// Catálogo global de tipos de dispositivo (ex.: Nobreak, Servidor, Rack, Switch)
model DeviceType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brands      BrandDeviceType[]
  devices     Device[]
}

// Catálogo global de marcas (ex.: APC, Dell, HP)
model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  logoUrl     String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deviceTypes BrandDeviceType[]
  devices     Device[]
}

// Relação N:N entre Marcas e Tipos de Dispositivo
model BrandDeviceType {
  id            String     @id @default(uuid())
  brand         Brand      @relation(fields: [brandId], references: [id])
  brandId       String
  deviceType    DeviceType @relation(fields: [deviceTypeId], references: [id])
  deviceTypeId  String
  createdAt     DateTime   @default(now())

  @@unique([brandId, deviceTypeId])
}

// Inventário de dispositivos
model Device {
  id           String     @id @default(uuid())
  deviceType   DeviceType @relation(fields: [deviceTypeId], references: [id])
  deviceTypeId String
  brand        Brand      @relation(fields: [brandId], references: [id])
  brandId      String
  model        String
  slug         String?
  uHeight      Int?
  isFullDepth  Boolean    @default(false)
  frontImage   Boolean    @default(false)
  rearImage    Boolean    @default(false)
  weight       Float?
  weightUnit   String?    @default("kg")
  airflow      String?
  consolePorts Json?
  interfaces   Json?
  moduleBays   Json?
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Configurações globais (ex.: chaves de integração) com valor criptografado
model Setting {
  id         String   @id @default(uuid())
  key        String   @unique
  valueEnc   String
  updatedBy  String?
  updatedAt  DateTime @default(now()) @updatedAt
}

// Resultado de análise por IA atrelado a um teste de maturidade
model MaturityAnalysis {
  id            String             @id @default(uuid())
  assessment    MaturityAssessment @relation(fields: [assessmentId], references: [id])
  assessmentId  String             @unique
  content       Json
  provider      String?
  model         String?
  createdById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

enum IpAddressStatus {
  ASSIGNED
  RESERVED
}

model Vrf {
  id        String   @id @default(uuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subnets   IpSubnet[]

  @@unique([companyId, name])
}

model Site {
  id        String   @id @default(uuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  name      String
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vlans     Vlan[]
  subnets   IpSubnet[]
  firewallLicenses FirewallLicense[]
  backupRepositories BackupRepository[]
  backupProxies BackupProxy[]
  inventoryCampaignSites InventoryCampaignSite[]
  inventoryAssetSnapshots InventoryAssetSnapshot[]
  inventoryAssetUsers InventoryAssetUser[]
  microsoftAgreements MicrosoftAgreement[]

  @@unique([companyId, name])
}

model Vlan {
  id        String   @id @default(uuid())
  site      Site     @relation(fields: [siteId], references: [id])
  siteId    String
  number    Int
  name      String
  purpose   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subnets   IpSubnet[]

  @@unique([siteId, number])
}

model FirewallLicense {
  id          String   @id @default(uuid())
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  site        Site?    @relation(fields: [siteId], references: [id])
  siteId      String?
  ipAddress   IpAddress? @relation(name: "IpAddressFirewallLicenses", fields: [ipAddressId], references: [id])
  ipAddressId String?
  vendor      String
  model       String
  serial      String
  licenseName String
  licenseNumber String?
  licenseFileUrl String?
  expiresAt   DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([siteId])
  @@index([expiresAt])
  @@index([ipAddressId])
}

model IpSubnet {
  id          String   @id @default(uuid())
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  site        Site?    @relation(fields: [siteId], references: [id])
  siteId      String?
  vrf         Vrf?     @relation(fields: [vrfId], references: [id])
  vrfId       String?
  vlan        Vlan?    @relation(fields: [vlanId], references: [id])
  vlanId      String?
  name        String
  cidr        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addresses   IpAddress[]

  @@index([companyId])
  @@index([siteId])
  @@index([vrfId])
  @@index([vlanId])
}

model IpAddress {
  id         String          @id @default(uuid())
  subnet     IpSubnet        @relation(fields: [subnetId], references: [id])
  subnetId   String
  address    String
  hostname   String?
  status     IpAddressStatus @default(ASSIGNED)
  assignedTo String?
  createdAt  DateTime        @default(now())

  firewallLicenses FirewallLicense[] @relation(name: "IpAddressFirewallLicenses")

  @@unique([subnetId, address])
}

// Backup
enum BackupRunStatus {
  SUCCESS
  WARN
  FAIL
}

model BackupRepository {
  id           String   @id @default(uuid())
  company      Company  @relation(fields: [companyId], references: [id])
  companyId    String
  site         Site?    @relation(fields: [siteId], references: [id])
  siteId       String?
  name         String
  type         String
  capacityGB   Int
  usedGB       Int      @default(0)
  retentionPolicy String?
  compressionRatio Float?
  dedupeRatio     Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@index([siteId])

  jobs BackupJob[]
}

model BackupProxy {
  id         String   @id @default(uuid())
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String
  site       Site?    @relation(fields: [siteId], references: [id])
  siteId     String?
  hostname   String
  cores      Int
  memoryGB   Int
  throughputMBps Int?
  concurrency Int?
  transportMode String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([siteId])

  jobs BackupJob[]
}

model BackupCore {
  id          String   @id @default(uuid())
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  hostname    String
  version     String?
  license     String?
  jobsCount   Int       @default(0)
  repositoriesCount Int @default(0)
  proxiesCount Int      @default(0)
  healthStatus String?  @default("UNKNOWN")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
}

model BackupJob {
  id            String   @id @default(uuid())
  company       Company  @relation(fields: [companyId], references: [id])
  companyId     String
  name          String
  type          String
  schedule      String?
  retentionPolicy String?
  repository    BackupRepository @relation(fields: [repositoryId], references: [id])
  repositoryId  String
  proxy         BackupProxy?     @relation(fields: [proxyId], references: [id])
  proxyId       String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runs          BackupRun[]

  @@index([companyId])
  @@index([repositoryId])
  @@index([proxyId])
}

model BackupRun {
  id            String          @id @default(uuid())
  job           BackupJob       @relation(fields: [jobId], references: [id])
  jobId         String
  startAt       DateTime
  endAt         DateTime?
  status        BackupRunStatus
  processedGB   Float           @default(0)
  transferredGB Float           @default(0)
  avgSpeedMBps  Float?
  bottleneck    String?
  errors        String?
  restorePointsCreated Int?     @default(0)
  createdAt     DateTime        @default(now())

  @@index([jobId])
  @@index([status])
}

model BackupSummaryMonthly {
  id           String   @id @default(uuid())
  company      Company  @relation(fields: [companyId], references: [id])
  companyId    String
  month        String
  jobsTotal    Int      @default(0)
  successRate  Float    @default(0)
  failures     Int      @default(0)
  avgDurationMinutes Float @default(0)
  storageGrowthGB Float  @default(0)
  topIssues    String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, month])
}

model BackupRepositoryOverride {
  id                  String   @id @default(uuid())
  company             Company  @relation(fields: [companyId], references: [id])
  companyId           String
  zabbixHostId        String
  repositoryId        String
  repositoryName      String
  repositoryType      String?
  capacityGB          Float?
  usedSpaceGB         Float?
  freeGB              Float?
  protectedSizeGB     Float?
  fullBackupSizeGB    Float?
  dailyChangePercent  Float?
  currentRetentionDays Int?
  retentionDays       Int?
  dailyFrequency      Int?
  backupMode          String?
  safetyMarginPercent Float?
  notes               String?
  useManualForPlanning Boolean @default(false)
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([companyId, zabbixHostId, repositoryId])
  @@index([companyId])
  @@index([zabbixHostId])
}

model BackupRepositoryJobOverride {
  id                  String   @id @default(uuid())
  company             Company  @relation(fields: [companyId], references: [id])
  companyId           String
  zabbixHostId        String
  repositoryId        String
  jobId               String
  jobName             String
  protectedSizeGB     Float?
  fullBackupSizeGB    Float?
  fullWeeklyExecutionMinutes Float?
  dailyChangePercent  Float?
  currentRetentionDays Int?
  retentionDays       Int?
  dailyFrequency      Int?
  backupMode          String?
  safetyMarginPercent Float?
  notes               String?
  useManualForPlanning Boolean @default(false)
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([companyId, zabbixHostId, repositoryId, jobId])
  @@index([companyId])
  @@index([zabbixHostId])
  @@index([repositoryId])
}

model BackupCollectionConfig {
  id              String   @id @default(uuid())
  scope           String   @unique @default("global")
  enabled         Boolean  @default(true)
  intervalHours   Int      @default(12)
  retentionDays   Int      @default(30)
  allowManualRun  Boolean  @default(true)
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  lastTriggerType String?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BackupVeeamSnapshotRaw {
  id             String   @id @default(uuid())
  company        Company  @relation(fields: [companyId], references: [id])
  companyId      String
  zabbixHostId   String
  zabbixHostName String?
  itemId         String
  itemName       String?
  sourceClock    Int
  triggerType    String
  payloadHash    String
  payloadJson    Json
  createdAt      DateTime @default(now())

  @@unique([companyId, zabbixHostId, itemId, sourceClock])
  @@index([companyId, createdAt])
  @@index([zabbixHostId, createdAt])
  @@index([itemId, sourceClock])
}

enum AdFsNodeType {
  ROOT
  UNIT
  SECTOR
  SUBSECTOR
  FOLDER
}

enum AdFsGroupKind {
  GF
  GA
}

enum AdFsPermissionProfile {
  L
  LG
  LE
  R
  RW
  RM
  FULL
}

enum AdFsProjectStatus {
  DRAFT
  APPROVED
  IMPLEMENTED
}

enum InventoryCampaignStatus {
  PLANNING
  COLLECTING
  WAITING_DOCUMENTS
  RECONCILING
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum InventorySourceType {
  GLPI
  SPREADSHEET
  MANUAL
  AI_ASSISTED
}

enum InventoryVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum InventoryDocumentType {
  INVOICE
  CONTRACT
  CERTIFICATE
  PHOTO
  SCREENSHOT
  OTHER
}

enum InventoryDocumentVerificationStatus {
  NOT_REVIEWED
  VERIFIED
  DIVERGENT
}

enum InventoryAllocationTargetType {
  DEVICE
  USER
  TENANT
  SERVER
  OTHER
}

enum InventoryReconciliationStatus {
  REGULAR
  POSSIBLE_EXCESS
  LICENSE_NOT_FOUND
  DOCUMENT_NOT_FOUND
  ALLOCATION_NOT_IDENTIFIED
  EXPIRED
  EXPIRING_SOON
  DIVERGENT
  NOT_APPLICABLE
  PENDING_ANALYSIS
}

enum InventorySuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InventoryIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  IGNORED
}

enum MicrosoftProvider {
  INGRAM
  SCANSOURCE
  MANUAL
}

enum MicrosoftConnectionStatus {
  NOT_CONFIGURED
  CONFIGURED
  CONNECTED
  ERROR
}

enum MicrosoftCustomerMapStatus {
  SUGGESTED
  CONFIRMED
  IGNORED
  MAPPED
  UNMAPPED
  REVIEW
  NOT_FOUND
}

enum MicrosoftAgreementStatus {
  ACTIVE
  EXPIRING_90
  EXPIRING_60
  EXPIRING_30
  EXPIRED
  AUTO_RENEW
  PENDING_MAPPING
  PENDING_REVIEW
  SYNC_ERROR
  CANCELLED
}

enum MicrosoftSourceType {
  RENEWAL
  SUBSCRIPTION
  INVOICE
  ORDER
  QUOTE
  PRICING_AGREEMENT
  MANUAL
}

enum MicrosoftDocumentType {
  INVOICE
  CONTRACT
  PDF
  QUOTE
  ORDER
  OTHER
}

enum MicrosoftSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  ERROR
}

model AdFsProject {
  id          String             @id @default(uuid())
  company     Company            @relation(fields: [companyId], references: [id])
  companyId   String
  name        String
  description String?
  domainName  String?
  rootOuName  String?
  rootPath    String             @default("D:\\FILESERVER")
  userHomeDriveLetter String?    @default("U")
  userHomeLocalRoot   String?
  userHomeShareRoot   String?
  status      AdFsProjectStatus  @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  orgNodes    AdFsOrgNode[]
  ouNodes     AdFsOuNode[]
  groups      AdFsGroup[]
  users       AdFsUserPlan[]
  folders     AdFsFolderNode[]
  gpos        AdFsGpoPlan[]

  @@index([companyId])
}

model AdFsOrgNode {
  id          String       @id @default(uuid())
  project     AdFsProject  @relation(fields: [projectId], references: [id])
  projectId   String
  parent      AdFsOrgNode? @relation("AdFsOrgTree", fields: [parentId], references: [id])
  parentId    String?
  children    AdFsOrgNode[] @relation("AdFsOrgTree")
  type        AdFsNodeType
  name        String
  code        String?
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       AdFsUserPlan[]
  folders     AdFsFolderNode[]
  groups      AdFsGroup[]

  @@index([projectId])
  @@index([parentId])
}

model AdFsOuNode {
  id          String       @id @default(uuid())
  project     AdFsProject  @relation(fields: [projectId], references: [id])
  projectId   String
  parent      AdFsOuNode?  @relation("AdFsOuTree", fields: [parentId], references: [id])
  parentId    String?
  children    AdFsOuNode[] @relation("AdFsOuTree")
  name        String
  distinguishedName String?
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       AdFsUserPlan[]
  gpos        AdFsGpoPlan[]

  @@index([projectId])
  @@index([parentId])
}

model AdFsGroup {
  id          String         @id @default(uuid())
  project     AdFsProject    @relation(fields: [projectId], references: [id])
  projectId   String
  kind        AdFsGroupKind
  name        String
  description String?
  permission  AdFsPermissionProfile?
  orgNode     AdFsOrgNode?   @relation(fields: [orgNodeId], references: [id])
  orgNodeId   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  members     AdFsUserPlan[] @relation("AdFsGroupMembers")
  folderPermissions AdFsFolderPermission[]

  @@index([projectId])
  @@index([orgNodeId])
}

model AdFsUserPlan {
  id          String       @id @default(uuid())
  project     AdFsProject  @relation(fields: [projectId], references: [id])
  projectId   String
  orgNode     AdFsOrgNode? @relation(fields: [orgNodeId], references: [id])
  orgNodeId   String?
  ouNode      AdFsOuNode?  @relation(fields: [ouNodeId], references: [id])
  ouNodeId    String?
  fullName    String
  firstName   String
  lastName    String?
  username    String
  email       String?
  title       String?
  enabled     Boolean      @default(true)
  initialPassword String?
  homeDriveEnabled Boolean @default(false)
  homeDriveLetter  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  groups      AdFsGroup[]  @relation("AdFsGroupMembers")

  @@index([projectId])
  @@index([orgNodeId])
  @@index([ouNodeId])
}

model AdFsFolderNode {
  id          String       @id @default(uuid())
  project     AdFsProject  @relation(fields: [projectId], references: [id])
  projectId   String
  parent      AdFsFolderNode? @relation("AdFsFolderTree", fields: [parentId], references: [id])
  parentId    String?
  children    AdFsFolderNode[] @relation("AdFsFolderTree")
  orgNode     AdFsOrgNode? @relation(fields: [orgNodeId], references: [id])
  orgNodeId   String?
  type        AdFsNodeType @default(FOLDER)
  name        String
  pathOverride String?
  disableInheritance Boolean @default(true)
  appliesTo   String?      @default("ThisFolderOnly")
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  permissions  AdFsFolderPermission[]

  @@index([projectId])
  @@index([parentId])
  @@index([orgNodeId])
}

model AdFsFolderPermission {
  id           String                @id @default(uuid())
  folderNode   AdFsFolderNode        @relation(fields: [folderNodeId], references: [id])
  folderNodeId String
  group        AdFsGroup             @relation(fields: [groupId], references: [id])
  groupId      String
  permission   AdFsPermissionProfile
  appliesTo    String                @default("ThisFolderSubfoldersAndFiles")
  deny         Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([folderNodeId])
  @@index([groupId])
}

model AdFsGpoPlan {
  id          String       @id @default(uuid())
  project     AdFsProject  @relation(fields: [projectId], references: [id])
  projectId   String
  ouNode      AdFsOuNode?  @relation(fields: [ouNodeId], references: [id])
  ouNodeId    String?
  name        String
  description String?
  category    String?
  linkEnabled Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@index([ouNodeId])
}

model InventoryCampaign {
  id                    String                  @id @default(uuid())
  company               Company                 @relation(fields: [companyId], references: [id])
  companyId             String
  name                  String
  objective             String?
  scopeSummary          String?
  openedAt              DateTime                @default(now())
  collectedAt           DateTime?
  closedAt              DateTime?
  status                InventoryCampaignStatus @default(PLANNING)
  sourcesUsed           Json?
  notes                 String?
  reviewResult          Json?
  compareWithCampaign   InventoryCampaign?      @relation("InventoryCampaignComparison", fields: [compareWithCampaignId], references: [id])
  compareWithCampaignId String?
  comparedByCampaigns   InventoryCampaign[]     @relation("InventoryCampaignComparison")
  createdById           String?
  updatedById           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  sites                 InventoryCampaignSite[]
  participants          InventoryCampaignParticipant[]
  importBatches         InventoryImportBatch[]
  assetSnapshots        InventoryAssetSnapshot[]
  documents             InventoryEvidenceDocument[]
  licenseEntitlements   InventoryLicenseEntitlement[]
  issues                InventoryIssue[]
